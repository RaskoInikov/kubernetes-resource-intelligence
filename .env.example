# Copy this file to .env for local development. Do not commit .env.
KRI_K8S_CONTEXT=kind-kube-optimizer
KRI_K8S_NAMESPACE=payments
KRI_WORKLOAD_IMAGE=kri-workload:local
KRI_PROMETHEUS_URL=http://localhost:9090
KRI_QDRANT_URL=http://localhost:6333
KRI_QDRANT_COLLECTION=kubernetes_knowledge
KRI_OLLAMA_URL=http://localhost:11434
KRI_OLLAMA_MODEL=qwen3:4b
# Pin this after `ollama list` for reproducible M12 runs.
# KRI_OLLAMA_MODEL_DIGEST=<64 lowercase hex characters from Ollama /api/tags>
KRI_OLLAMA_TIMEOUT_SECONDS=180
KRI_LLM_TEMPERATURE=0
KRI_LLM_SEED=42
KRI_LLM_CONTEXT_TOKENS=8192
KRI_LLM_MAX_OUTPUT_TOKENS=2048
